---
import SectionHeader from './SectionHeader.astro';
import TagList from './TagList.astro';
import { experience, sections } from '../data/site';

const copy = sections.experience;
---

<section id="experience" class="section container" aria-labelledby="experience-title">
  <SectionHeader number={2} label={copy.label} heading={copy.heading} headingId="experience-title" />

  <ol class="timeline" role="list">
    {
      experience.map((item, index) => (
        <li class:list={['entry', { 'entry-latest': index === 0 }]}>
          <div class="entry-body">
            <span class="entry-node" aria-hidden="true" />
            <p class="label entry-period">{item.period}</p>
            <h3 class="entry-role">
              {item.role}
              <span class="entry-at">
                {' '}
                at{' '}
                {item.organizationUrl ? (
                  <a class="link" href={item.organizationUrl} rel="noopener">
                    {item.organization}
                  </a>
                ) : (
                  item.organization
                )}
              </span>
            </h3>
            <p class="label entry-location">{item.location}</p>
            <ul class="entry-highlights" role="list">
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            {item.stack && <TagList tags={item.stack} label={`Tools used at ${item.organization}`} />}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .section {
    padding-top: var(--section-gap);
  }

  .timeline {
    display: grid;
    gap: var(--space-7);
  }

  .entry-body {
    position: relative;
    max-width: var(--width-prose);
    padding-left: var(--space-6);
    border-left: var(--border);
  }

  /* The connector line continues into the gap below each entry. */
  .entry:not(:last-child) .entry-body::after {
    content: '';
    position: absolute;
    left: -1px;
    top: 100%;
    height: var(--space-7);
    border-left: var(--border);
  }

  .entry-node {
    position: absolute;
    left: calc(-0.3125rem - 0.5px);
    top: 0.45rem;
    width: 0.625rem;
    height: 0.625rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border-strong);
    border-radius: 2px;
  }

  .entry-latest .entry-node {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .entry-period {
    margin-bottom: var(--space-2);
  }

  .entry-role {
    font-size: var(--text-lg);
  }

  .entry-at {
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  .entry-location {
    margin-top: var(--space-1);
  }

  .entry-highlights {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-4);
  }

  .entry-highlights li {
    position: relative;
    padding-left: var(--space-5);
  }

  .entry-highlights li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  /* Desktop: dates move into their own column, left of the line. */
  @media (min-width: 48rem) {
    .entry-body {
      margin-left: 12rem;
    }

    .entry-period {
      position: absolute;
      right: calc(100% + var(--space-6));
      top: 0.15rem;
      width: 10rem;
      margin: 0;
      text-align: right;
    }
  }
</style>
