---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { sections } from '../data/site';

const projects = await getProjects();
const copy = sections.work;
---

<section id="work" class="section container" aria-labelledby="work-title">
  <SectionHeader number={1} label={copy.label} heading={copy.heading} headingId="work-title" intro={copy.intro} />
  <div class="grid">
    {projects.map((project, index) => <ProjectCard project={project} index={index} eager={index === 0} />)}
  </div>
</section>

<style>
  .section {
    padding-top: var(--section-gap);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8) var(--space-7);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Offset the second column slightly: a notebook layout, not a uniform tile wall. */
    .grid > :global(:nth-child(even)) {
      margin-top: var(--space-8);
    }
  }
</style>
