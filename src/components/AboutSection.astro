---
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import { about, sections } from '../data/site';

const copy = sections.about;
const { education } = about;
---

<section id="about" class="section container" aria-labelledby="about-title">
  <SectionHeader number={3} label={copy.label} heading={copy.heading} headingId="about-title" />

  <div class="about-layout">
    <div class="about-story">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <aside class="about-aside" aria-label="Profile details">
      <figure class="photo">
        {
          about.photo ? (
            <Image src={about.photo.src} alt={about.photo.alt} widths={[320, 640]} sizes="320px" />
          ) : (
            <div class="photo-placeholder" role="img" aria-label="Photo placeholder">
              <span class="label">Photo · 4:5</span>
            </div>
          )
        }
      </figure>

      <dl class="facts">
        <div class="fact">
          <dt class="label">Education</dt>
          <dd>
            <span class="fact-strong">{education.school}</span>
            <span>{education.degree}</span>
            <span class="label">
              {education.period} · {education.location}
            </span>
          </dd>
        </div>
        <div class="fact">
          <dt class="label">Toolkit</dt>
          <dd class="skills">{about.skills.join(' · ')}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .section {
    padding-top: var(--section-gap);
  }

  .about-layout {
    display: grid;
    gap: var(--space-7);
  }

  .about-story {
    max-width: var(--width-prose);
  }

  .about-story p + p {
    margin-top: var(--space-5);
  }

  .about-story p:first-child {
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .about-aside {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .photo {
    max-width: 16rem;
  }

  .photo :global(img),
  .photo-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: var(--border);
    border-radius: var(--radius-md);
  }

  .photo-placeholder {
    display: grid;
    place-items: end start;
    padding: var(--space-3);
    background-color: var(--color-surface);
    /* Corner registration marks, like a frame on a drafting sheet. */
    background-image:
      linear-gradient(var(--color-border-strong), var(--color-border-strong)),
      linear-gradient(var(--color-border-strong), var(--color-border-strong)),
      linear-gradient(var(--color-border-strong), var(--color-border-strong)),
      linear-gradient(var(--color-border-strong), var(--color-border-strong));
    background-size: 14px 1px, 1px 14px, 14px 1px, 1px 14px;
    background-position:
      top 12px right 12px,
      top 12px right 12px,
      bottom 12px right 12px,
      bottom 12px right 12px;
    background-repeat: no-repeat;
  }

  .facts {
    display: grid;
    gap: var(--space-5);
  }

  .fact {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--border);
  }

  .fact dd {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .fact-strong {
    font-weight: var(--weight-medium);
  }

  .skills {
    color: var(--color-text-muted);
  }

  @media (min-width: 60rem) {
    .about-layout {
      grid-template-columns: minmax(0, var(--width-prose)) minmax(0, 18rem);
      justify-content: space-between;
      gap: var(--space-9);
    }
  }
</style>
